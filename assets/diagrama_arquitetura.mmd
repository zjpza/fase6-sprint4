%% AgroRisk AI - Arquitetura entregue na Sprint 4 (Fase 6)
%% Reflete o que roda de fato: coleta simulada -> ETL higienizado e rastreavel -> FastAPI -> SQLite -> modelo -> dashboard,
%% com seguranca JWT/RBAC e trilha de auditoria das decisoes.
flowchart TB
    subgraph S1["1 - Coleta de dados"]
        GEN["generate_dataset.py<br/>dataset deterministico (SEED=42)"]
        RAW["data/raw/dataset_simulado.csv"]
        SIM["simulador_telemetria.py<br/>retry 3x · --lote · --equipamento"]
        GEN --> RAW --> SIM
    end

    subgraph S2["2 - ETL / Feature Engineering"]
        FE["feature_engineering.py<br/>features de risco + validacao (ValueError descritivo)"]
        ART["scaler.pkl · label_encoders.pkl<br/>(artefatos gerados, fora do versionamento)"]
        PROC["data/processed/features.csv"]
        HIG["validacao_dados.py<br/>higienizacao: faltante · duplicado · dominio · faixa · incoerencia"]
        LOAD["load_to_sql.py<br/>carga idempotente (fonte + id_coleta)"]
        FE --> ART
        FE --> PROC --> HIG --> LOAD
    end

    subgraph S3["3 - Backend FastAPI"]
        ROUTES["routes.py<br/>login · telemetria · equipamentos · alertas · auditoria"]
        SVC["telemetria_service.py<br/>features -> score da regra -> predicao -> alerta"]
        CONEX["data/conexao.py<br/>FKs + busy_timeout compartilhado"]
    end

    subgraph S4["4 - Persistencia SQLite"]
        DB[("equipamentos · telemetria · scores_modelo · alertas · usuarios · auditoria · regras_risco<br/>+ views · UNIQUE(fonte,id_coleta) · gatilho de consistencia")]
    end

    subgraph S5["5 - Inteligencia scikit-learn"]
        TRAIN["ml/train_model.py<br/>revisao de features por CV + treino final"]
        MODEL["models/risk_model.pkl<br/>Random Forest · 11 features"]
        METRICS["ml/relatorio_metricas.md<br/>acuracia 0.835 · AUC 0.963"]
        PRED["ml/predictor.py<br/>score continuo + fatores por contribuicao"]
        TRAIN --> MODEL --> PRED
        TRAIN --> METRICS
    end

    subgraph S6["6 - Seguranca e auditoria"]
        AUTH["security/auth.py<br/>JWT HS256 · segredo por env (efemero sem env)"]
        RBAC["security/rbac.py<br/>RBAC por papel (operador · gestor · analista)"]
        AUDIT["security/audit_logger.py<br/>acesso + decisao_risco (scores, alerta, fatores)"]
    end

    subgraph S7["7 - Dashboard Streamlit"]
        APP["dashboard/app.py<br/>visoes por papel do token<br/>mapa · tendencias por regiao/operacao · criterios<br/>score regra x modelo · fatores · trilha · CSV"]
    end

    subgraph S8["8 - Personas"]
        U1["Operador (US-01)"]
        U2["Gestor de Frota (US-04)"]
        U3["Analista da Seguradora (US-07)"]
    end

    SIM -->|POST /telemetria + id_coleta| ROUTES
    ROUTES --> SVC
    SVC -->|registro + score + predicao| DB
    SVC --> PRED
    CONEX -.-> DB
    LOAD -->|carga tratada| DB
    DB -->|GET com JWT| APP
    AUTH -.-> ROUTES
    RBAC -.-> ROUTES
    AUDIT -.-> DB
    APP --> U1
    APP --> U2
    APP --> U3
    AUDIT -.->|GET /auditoria| APP

    classDef coleta fill:#7a1fa2,stroke:#fff,color:#fff
    classDef etl fill:#1f6feb,stroke:#fff,color:#fff
    classDef backend fill:#1f6feb,stroke:#fff,color:#fff
    classDef db fill:#0e8a6b,stroke:#fff,color:#fff
    classDef ml fill:#d63384,stroke:#fff,color:#fff
    classDef sec fill:#b8860b,stroke:#fff,color:#fff
    classDef viz fill:#e6007e,stroke:#fff,color:#fff
    classDef user fill:#444c5c,stroke:#fff,color:#fff

    class GEN,RAW,SIM coleta
    class FE,ART,PROC,HIG,LOAD etl
    class ROUTES,SVC,CONEX backend
    class DB db
    class TRAIN,MODEL,METRICS,PRED ml
    class AUTH,RBAC,AUDIT sec
    class APP viz
    class U1,U2,U3 user
