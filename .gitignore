# Ambiente virtual
venv/
.env/
.env

# Banco de dados local (gerado em tempo de execução pelo ETL)
*.db
*.sqlite
*.sqlite3

# Artefatos gerados pelo ETL em cada execução (não versionados)
src/data/scaler.pkl
src/data/label_encoders.pkl

# Modelos e artefatos grandes (podem ser gerados)
# Descomente a linha abaixo se quiser ignorar modelos treinados no controle de versão.
# *.pkl
# *.joblib

# Dados processados e brutos (podem ser regenerados)
data/raw/
data/processed/

# Cache Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# IDEs
.vscode/
.idea/
*.swp

# Streamlit
.streamlit/

# Logs de execução
logs/
*.log

# Sistema operacional
.DS_Store
Thumbs.db
